# ─── Kafka ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=parking.sensors.raw
KAFKA_TOPIC_DECISIONS=parking.decisions
KAFKA_TOPIC_ALERTS=parking.alerts

# ─── InfluxDB ─────────────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=my-super-secret-token
INFLUX_ORG=smart_parking
INFLUX_BUCKET=sensor_data

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/
MONGO_DB=smart_parking

# ─── Simulation ───────────────────────────────────────────
EMIT_INTERVAL_SECONDS=1
UNITS=3
